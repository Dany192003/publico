// server.js - Versión con Supabase
const express = require('express');
const cors = require('cors');
const jwt = require('jsonwebtoken');
const { createClient } = require('@supabase/supabase-js');
require('dotenv').config();

const app = express();
const PORT = process.env.PORT || 3000;
const JWT_SECRET = process.env.JWT_SECRET || 'torneo_secret_2026';
const ADMIN_PASSWORD = process.env.ADMIN_PASSWORD || 'admin2026';

// ===== CONFIGURACIÓN SUPABASE =====
const supabase = createClient(
    process.env.SUPABASE_URL,
    process.env.SUPABASE_KEY
);

app.use(cors());
app.use(express.json());
app.use(express.static('.'));

// ===== FUNCIONES DE AYUDA =====

function verificarToken(req, res, next) {
    const token = req.headers['authorization']?.split(' ')[1];
    if (!token) return res.status(401).json({ error: 'Token requerido' });
    try {
        jwt.verify(token, JWT_SECRET);
        next();
    } catch {
        res.status(401).json({ error: 'Token inválido' });
    }
}

// Obtener o crear torneo principal
async function getTorneoPrincipal() {
    let { data: torneo } = await supabase
        .from('torneos')
        .select('*')
        .eq('nombre', 'torneo_principal')
        .single();
    
    if (!torneo) {
        const { data: nuevo } = await supabase
            .from('torneos')
            .insert({ nombre: 'torneo_principal' })
            .select()
            .single();
        torneo = nuevo;
    }
    return torneo;
}

// ===== RUTAS =====

app.get('/api/health', (req, res) => {
    res.json({ status: 'ok', message: 'Servidor funcionando con Supabase' });
});

app.post('/api/login', (req, res) => {
    const { password } = req.body;
    if (password === ADMIN_PASSWORD) {
        const token = jwt.sign({ role: 'admin' }, JWT_SECRET, { expiresIn: '24h' });
        res.json({ success: true, token });
    } else {
        res.status(401).json({ success: false, error: 'Contraseña incorrecta' });
    }
});

// Obtener todos los datos del torneo
app.get('/api/torneo', async (req, res) => {
    try {
        const torneo = await getTorneoPrincipal();
        const torneoId = torneo.id;

        // Obtener juveniles con sus equipos
        const { data: juveniles } = await supabase
            .from('juveniles')
            .select('*')
            .eq('torneo_id', torneoId);

        // Obtener equipos
        const { data: equipos } = await supabase
            .from('equipos')
            .select('*')
            .eq('torneo_id', torneoId);

        // Obtener partidos con nombres de equipos
        const { data: partidosRaw } = await supabase
            .from('partidos')
            .select('*')
            .eq('torneo_id', torneoId);

        // Enriquecer partidos con nombres
        const partidos = await Promise.all((partidosRaw || []).map(async (p) => {
            const { data: e1 } = await supabase
                .from('equipos')
                .select('nombre')
                .eq('id', p.equipo1_id)
                .single();
            const { data: e2 } = await supabase
                .from('equipos')
                .select('nombre')
                .eq('id', p.equipo2_id)
                .single();
            return {
                ...p,
                equipo1: e1?.nombre || `Equipo ${p.equipo1_id}`,
                equipo2: e2?.nombre || `Equipo ${p.equipo2_id}`
            };
        }));

        // Obtener grupos
        const { data: grupos } = await supabase
            .from('grupos')
            .select('*')
            .eq('torneo_id', torneoId);

        res.json({
            nombre: torneo.nombre,
            configuracion: torneo.configuracion || { puntos_ganado: 3, puntos_empate: 1, puntos_perdido: 0 },
            juveniles: juveniles || [],
            equipos: equipos || [],
            grupos: grupos || [],
            partidos: partidos || [],
            llaves: grupos?.[0]?.llaves || null
        });
    } catch (error) {
        console.error('Error:', error);
        res.status(500).json({ error: error.message });
    }
});

// Registrar resultado de partido
app.post('/api/partidos/:id/resultado', verificarToken, async (req, res) => {
    const { id } = req.params;
    const { goles1, goles2 } = req.body;

    try {
        // Obtener partido
        const { data: partido } = await supabase
            .from('partidos')
            .select('*')
            .eq('id', id)
            .single();

        if (!partido) {
            return res.status(404).json({ error: 'Partido no encontrado' });
        }

        // Determinar ganador
        let ganador = null;
        if (goles1 > goles2) {
            const { data: e1 } = await supabase
                .from('equipos')
                .select('nombre')
                .eq('id', partido.equipo1_id)
                .single();
            ganador = e1?.nombre || 'Equipo 1';
        } else if (goles2 > goles1) {
            const { data: e2 } = await supabase
                .from('equipos')
                .select('nombre')
                .eq('id', partido.equipo2_id)
                .single();
            ganador = e2?.nombre || 'Equipo 2';
        } else {
            ganador = 'Empate';
        }

        // Actualizar partido
        await supabase
            .from('partidos')
            .update({
                goles1,
                goles2,
                ganador,
                jugado: true,
                en_vivo: false
            })
            .eq('id', id);

        // Actualizar estadísticas de los equipos
        await actualizarEstadisticas(partido.torneo_id);

        res.json({ success: true, message: 'Resultado registrado' });
    } catch (error) {
        console.error('Error:', error);
        res.status(500).json({ error: error.message });
    }
});

// Iniciar/Detener partido en vivo
app.post('/api/partidos/:id/en_vivo', verificarToken, async (req, res) => {
    const { id } = req.params;
    const { en_vivo } = req.body;

    try {
        await supabase
            .from('partidos')
            .update({ en_vivo })
            .eq('id', id);

        res.json({ success: true, message: `Partido ${en_vivo ? 'en vivo' : 'finalizado'}` });
    } catch (error) {
        res.status(500).json({ error: error.message });
    }
});

// Reiniciar resultados
app.post('/api/reiniciar', verificarToken, async (req, res) => {
    try {
        const torneo = await getTorneoPrincipal();

        // Reiniciar partidos
        await supabase
            .from('partidos')
            .update({
                goles1: null,
                goles2: null,
                ganador: null,
                jugado: false,
                en_vivo: false
            })
            .eq('torneo_id', torneo.id);

        // Reiniciar estadísticas
        await supabase
            .from('equipos')
            .update({
                ganados: 0,
                empatados: 0,
                perdidos: 0,
                goles_favor: 0,
                goles_contra: 0,
                puntos: 0
            })
            .eq('torneo_id', torneo.id);

        res.json({ success: true, message: 'Resultados reiniciados' });
    } catch (error) {
        res.status(500).json({ error: error.message });
    }
});

// Función para actualizar estadísticas
async function actualizarEstadisticas(torneoId) {
    // Obtener todos los equipos del torneo
    const { data: equipos } = await supabase
        .from('equipos')
        .select('id')
        .eq('torneo_id', torneoId);

    // Obtener todos los partidos jugados
    const { data: partidos } = await supabase
        .from('partidos')
        .select('*')
        .eq('torneo_id', torneoId)
        .eq('jugado', true);

    // Reiniciar estadísticas
    for (const equipo of equipos || []) {
        await supabase
            .from('equipos')
            .update({
                ganados: 0,
                empatados: 0,
                perdidos: 0,
                goles_favor: 0,
                goles_contra: 0,
                puntos: 0
            })
            .eq('id', equipo.id);
    }

    // Calcular estadísticas
    for (const p of partidos || []) {
        const e1 = equipos?.find(e => e.id === p.equipo1_id);
        const e2 = equipos?.find(e => e.id === p.equipo2_id);
        if (!e1 || !e2) continue;

        // Actualizar goles
        await supabase.rpc('incrementar_goles', {
            p_equipo_id: e1.id,
            p_goles_favor: p.goles1 || 0,
            p_goles_contra: p.goles2 || 0
        });
        await supabase.rpc('incrementar_goles', {
            p_equipo_id: e2.id,
            p_goles_favor: p.goles2 || 0,
            p_goles_contra: p.goles1 || 0
        });

        // Actualizar resultados
        if ((p.goles1 || 0) > (p.goles2 || 0)) {
            await supabase.rpc('incrementar_resultado', {
                p_equipo_id: e1.id,
                p_ganado: 1,
                p_perdido: 0,
                p_empatado: 0,
                p_puntos: 3
            });
            await supabase.rpc('incrementar_resultado', {
                p_equipo_id: e2.id,
                p_ganado: 0,
                p_perdido: 1,
                p_empatado: 0,
                p_puntos: 0
            });
        } else if ((p.goles2 || 0) > (p.goles1 || 0)) {
            await supabase.rpc('incrementar_resultado', {
                p_equipo_id: e2.id,
                p_ganado: 1,
                p_perdido: 0,
                p_empatado: 0,
                p_puntos: 3
            });
            await supabase.rpc('incrementar_resultado', {
                p_equipo_id: e1.id,
                p_ganado: 0,
                p_perdido: 1,
                p_empatado: 0,
                p_puntos: 0
            });
        } else {
            await supabase.rpc('incrementar_resultado', {
                p_equipo_id: e1.id,
                p_ganado: 0,
                p_perdido: 0,
                p_empatado: 1,
                p_puntos: 1
            });
            await supabase.rpc('incrementar_resultado', {
                p_equipo_id: e2.id,
                p_ganado: 0,
                p_perdido: 0,
                p_empatado: 1,
                p_puntos: 1
            });
        }
    }
}

app.listen(PORT, () => {
    console.log(`🚀 Servidor con Supabase corriendo en http://localhost:${PORT}`);
    console.log(`🔐 Panel admin: http://localhost:${PORT}/admin.html`);
    console.log(`👀 Vista pública: http://localhost:${PORT}/index.html`);
});